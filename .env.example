# Copiez ce fichier en « .env » puis remplissez-le. Ne le partagez jamais.

# --- Gmail (boîte dédiée qui reçoit les alertes) ---
GMAIL_ADRESSE=ma.boite.appart@gmail.com
# Mot de passe d'application à 16 lettres (PAS votre mot de passe Gmail habituel)
GMAIL_MOT_DE_PASSE_APPLICATION=abcd efgh ijkl mnop
# Votre adresse perso (facultatif) : mise en copie (Cc, visible) de chaque candidature, et adresse
# où les agences répondent (« Répondre à »). Utilisable aussi dans templates.md avec {mon_email}.
EMAIL_REPONSE=mon.adresse.perso@exemple.fr
# Nom affiché comme expéditeur à la place de l'adresse Gmail (facultatif)
NOM_EXPEDITEUR=Prénom Nom
# Dossier à surveiller (INBOX = boîte de réception)
DOSSIER_IMAP=INBOX

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:AAH...
TELEGRAM_CHAT_ID=123456789

# --- Vos critères ---
PRIX_MAX_CC=900
# Vos revenus nets mensuels (facultatif) : affiche la part du loyer dans vos revenus
REVENU_NET_MENSUEL=0
# Prix maximum pour une colocation (détectée par le mot « colocation » / « coloc »)
PRIX_MAX_COLOC=600
# Zones acceptées : « Paris » (les 20 arrondissements), « Paris 13e » pour un seul,
# ou un nom de commune (liste dans zones.py)
ZONES=Paris, Ivry-sur-Seine, Maisons-Alfort, Clamart, Asnières-sur-Seine, Bois-Colombes, Vitry-sur-Seine, Saint-Denis, Montreuil, Meudon, Vincennes, Charenton-le-Pont, Montrouge, Clichy, Boulogne-Billancourt, Issy-les-Moulineaux
# Zones signalées par ⭐ dans Telegram et dans suivi.csv
PRIORITES=Ivry-sur-Seine, Maisons-Alfort, Paris 13e, Paris 14e, Asnières-sur-Seine
# Sites dont toutes les annonces sont gardées quel que soit le lieu (le prix max s'applique toujours).
# Utile pour les alertes « à 30 min de… » (vide = aucun site)
SOURCES_TOUTES_ZONES=seloger,jinka
# Mots recherchés dans l'adresse de l'expéditeur des alertes
EXPEDITEURS=jinka,seloger,pap

# --- Fichiers ---
# Votre dossier de location en PDF (chemin relatif au dossier du projet, ou absolu)
DOSSIER_PDF=dossier.pdf
FICHIER_MODELE=templates.md
FICHIER_SUIVI=suivi.csv
FICHIER_DB=annonces.db

# --- Rythme ---
INTERVALLE_SECONDES=120
RELANCE_HEURES=48
# Au premier lancement, nombre de jours d'emails passés à analyser
JOURS_HISTORIQUE=2

# --- Notifications ---
# 🟢 arrivent avec son, 🟡 en silence. Les 🔴 : soir (dans le résumé du soir), direct, ou jamais
ROUGES=soir
# Heure du résumé du soir et du bilan du matin « je tourne toujours » (vide = désactivé)
HEURE_RESUME_SOIR=21
HEURE_BILAN_MATIN=8
# Réaction dès qu'un email arrive (1) ou seulement toutes les 2 minutes (0)
IMAP_IDLE=1

# --- Agents (facultatif) : évaluation, recherche du contact de l'agence, choix du canal ---
# IA gratuite compatible OpenAI. Groq : https://console.groq.com -> API Keys (gratuit, sans carte)
LLM_CLE=
LLM_URL=https://api.groq.com/openai/v1
LLM_MODELE=openai/gpt-oss-120b
# Recherche web : https://app.tavily.com (1 000 recherches/mois gratuites, sans carte)
TAVILY_CLE=
# 1 = agents actifs (si LLM_CLE est remplie), 0 = désactivés
AGENTS=1
# Niveaux d'annonces confiés aux agents : vert, jaune, rouge
AGENTS_NIVEAUX=vert,jaune
# Plafonds par jour (pour rester dans les offres gratuites)
LLM_MAX_JOUR=300
RECHERCHES_MAX_JOUR=30
